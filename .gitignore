# ── Secrets — never commit ───────────────────────────────────────────────
config/api_keys.json
config/certs/
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Runtime state ────────────────────────────────────────────────────────
memory/*.json
*.log
logs/
.pytest_cache/

# ── Editor / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak

# Données de mesure locales, régénérées par `python -m tools.jarvis_health --measure`.
.jarvis-health/
.coverage
